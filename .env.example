# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git — never commit it or paste keys anywhere else.
# On Hugging Face, put these in the Space's Settings → "Variables and secrets"
# instead (secrets for passwords and keys, variables for the rest).

# ── Sign-in ──────────────────────────────────────────────────────────────────
# 0 = anyone can use the site; a "Sign in" button is in the header (current plan)
# 1 = the site opens on the sign-in page (switch back to this later)
REQUIRE_LOGIN=0

# Session cookies are "Secure" (HTTPS only) by default, which is right for
# Hugging Face. For http://localhost testing set this to 0.
AUTH_COOKIE_SECURE=0

# A long random string that makes stored sign-in tokens useless to anyone who
# copies the database. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it the same once set — changing it signs everyone out.
AUTH_TOKEN_PEPPER=

# Optional: comma-separated emails that get the ticket admin page (/tickets_ui).
# The accounts must already exist; applied when the app starts.
ADMIN_EMAILS=

# ── MongoDB (chat history, accounts, tickets) ────────────────────────────────
# From MongoDB Atlas: Connect → Drivers → copy the connection string and put
# your database user's password in it. If this is missing or wrong the
# dashboard still runs; chat history, sign-in and tickets show as
# "temporarily unavailable".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pr_chat
# How long one database call may wait, in milliseconds.
MONGODB_TIMEOUT_MS=3000

# ── AI assistant ─────────────────────────────────────────────────────────────
# openai = OpenAI's API (needed on Hugging Face)
# ollama = a model running on your own computer (see README)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# gpt-5-nano is what V10 used. The partner branch's default is gpt-5.6-luna.
# Pick deliberately: it changes cost and which keys/projects can use it.
OPENAI_MODEL=gpt-5-nano
OLLAMA_MODEL=qwen3.5:9b
# Only if Ollama runs somewhere other than this computer:
# OLLAMA_HOST=http://localhost:11434

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=7860
# DASH_DEBUG=1   (local development only — never on a public site)
